====
import unittest
from bs4 import BeautifulSoup
import requests

class myTests(unittest.TestCase):

    def testOne(self):
        file = 'WikipediaMOOC-Jan-12-2018.html'
        fh = open(file)
        text = fh.read()
        fh.close()
        soup = BeautifulSoup(text, 'html.parser')
        output = coursera_dict(soup)
        self.assertEqual(len(output), 9)
        self.assertEqual(output["United States"], "27.7%")
        self.assertEqual(output["India"], "8.8%")
        self.assertEqual(output["Brazil"], "5.1%")
        self.assertEqual(output["Rest of world"], "41.9%")

unittest.main()
        </code>
    </program>
</activity>    


