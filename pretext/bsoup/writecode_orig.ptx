====
import unittest
from bs4 import BeautifulSoup
import requests

class myTests(unittest.TestCase):

    def testOne(self):   
        fh = open('PythonKeywords.html')
        text = fh.read()
        fh.close()

        # create the soup object and print the results
        soup = BeautifulSoup(text, 'html.parser')
        keywords_list = keywords(soup)
        self.assertEqual(keywords_list[0:3], ['and', 'as', 'assert'])
        self.assertEqual(len(keywords_list), 37)

unittest.main()
        </code>
    </program>
</activity>

