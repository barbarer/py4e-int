    <program  interactive="activecode" language="python3">
        <code>
from bs4 import BeautifulSoup
import requests
import re

def bsi_list(url):

====
import unittest
import requests
from bs4 import BeautifulSoup

def f_bsi_list(url):
    list1 = []
    r = requests.get(url)
    soup = BeautifulSoup(r.text, 'html.parser')
    sections = soup.find_all('a', href = re.compile("/programs/bachelor-science-information/"))
    for section in sections[:-2]:
        list1.append(section.text.strip())
    return list1

class myTests(unittest.TestCase):

    def testOne(self):
        url = 'https://www.si.umich.edu/programs/bachelor-science-information'
        self.assertEqual(bsi_list(url),f_bsi_list(url),f'bsi_list({url}),'

unittest.main()
        </code>
    </program>
</activity>

<activity xml:id="bsoup_writecode7q_v2" label="bsoup_writecode7q_v2">
