        <activity xml:id="var-wc-feetq" label="var-wc-feetq">
  <statement>
    <p>Write a program that will convert a user entered number of inches to feet.
       Reminder: there are 12 inches in a foot. Store the number of inches entered
       by the user in a variable called <c>inches</c>, and store the result in a
       variable called <c>feet</c> and print it.</p>
  </statement>
  <program interactive="activecode" language="python">
    <code>

    </code>
    <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):

    def testVariablesExist(self):
        try:
            inches
        except NameError:
            self.fail("Checking that a variable named 'inches' was created")
        try:
            feet
        except NameError:
            self.fail("Checking that a variable named 'feet' was created")

    def testConversion(self):
        expected = float(inches) / 12
        self.assertAlmostEqual(float(feet), expected, None,
            "Checking that feet equals inches divided by 12", delta=0.01)


    def testOutput(self):
        self.assertIn(str(round(float(inches)/12, 1)), self.getOutput().replace(str(float(inches)), ""),
            "Checking that the converted value appears in the printed output")

myTests().main()
    </tests>
  </program>
  <solution>
    <program language="python">
      <code>
inches = float(input("Enter a number of inches: "))
feet = inches / 12
print(str(inches) + " inches is " + str(feet) + " feet.")
      </code>
    </program>
  </solution>
        </activity>

                <activity xml:id="var-wc-inch" label="var-wc-inch">
          <statement>
            <p>Write a program that will convert a user entered number of feet to inches.
              Reminder: there are 12 inches in a foot. Store the number of feet
              entered by the user in a variable called <c>feet</c>, and store the result in a
              variable called <c>inches</c> and print it.</p>                            
          </statement>
          <program interactive="activecode" language="python">
            <code>

            </code>
    <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):

    def testVariablesExist(self):
        try:
            inches
        except NameError:
            self.fail("Checking that a variable named 'feet' was created")
        try:
            feet
        except NameError:
            self.fail("Checking that a variable named 'inches' was created")

    def testConversion(self):
        expected = float(feet) * 12
        self.assertAlmostEqual(float(inches), expected, None,
            "Checking that feet equals inches multiplied by 12", delta=0.01)


    def testOutput(self):
        self.assertIn(str(round(float(feet)*12, 1)), self.getOutput().replace(str(float(feet)), ""),
            "Checking that the converted value appears in the printed output")

myTests().main()
    </tests>

          </program>
          </activity>


        <activity xml:id="var-wc-combine" label="var-wc-combine">
          <statement>
            <p>Replace lines 4 and 5 below with a single <c>print()</c> statement that combines
              them, so the program prints exactly: <q>270 is 4.0 hours and 30 minutes.</q></p>
          </statement>
          <program interactive="activecode" language="python" >
            <code>
totalMinutes = 270
numMinutes = totalMinutes % 60
numHours = (totalMinutes - numMinutes) / 60
print(numHours)
print(numMinutes)
          </code>
          <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):
    def testOutput(self):
        expected = "270 is 4.0 hours and 30 minutes."
        actual = self.getOutput().strip()
        self.assertEqual(actual, expected,
                         "Checking that the program prints the correct sentence")

myTests().main()
          </tests>

          </program>
          <solution>
              <p>Combine lines 4 and 5 in the code below to print: <q>270 is 4.0 hours and 30 minutes.</q>.</p>
    <program interactive="activecode"  language="python" label="var-wc-combine-sol"><code>
totalMinutes = 270
numMinutes = totalMinutes % 60
numHours = (totalMinutes - numMinutes) / 60
# Use + and correctly spaced " " to write the variables out together
print(str(totalMinutes) + " is " + str(numHours) + " hours and " + str(numMinutes) + " minutes.")
        </code>
    </program>         
</solution>
