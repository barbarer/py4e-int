        <activity xml:id="writingcode_network_9" label="writingcode_network_9"><statement>
                <p>Complete the following code to print all the image sources from
                    the webpage. Use ‘img' and ‘src' as tags.</p>

    </statement><program interactive="activecode" language="python3">
        <code>
import requests
from bs4 import BeautifulSoup

url = "https://www.nytimes.com/"
resp = requests.get(url)
soup = BeautifulSoup(resp.content, 'html.parser')
        </code>
    </program><solution><p>Complete the following code to print all the image sources from the webpage. Use ‘img' and ‘src' as tags.</p>
        <program xml:id="writingcode_network_9_sol" language="python3" interactive="activecode">
        <code>
import requests
from bs4 import BeautifulSoup

url = "https://www.nytimes.com/"
resp = requests.get(url)
soup = BeautifulSoup(resp.content, 'html.parser')

tags = soup('img')
for tag in tags:
    print(tag.get('src', None))
        </code>
    </program></solution></activity>

