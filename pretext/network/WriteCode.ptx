        <activity xml:id="writingcode_network_5" label="writingcode_network_5"><statement>
                <p>Write a program to store image file from ‘<url href="http://data.pr4e.org/cover.jpg" visual="http://data.pr4e.org/cover.jpg">http://data.pr4e.org/cover.jpg</url>'
                    to your disk.</p>

    </statement><program interactive="activecode" language="python3">
        <code>
import urllib.request, urllib.parse, urllib.error
        </code>
    </program><solution><p>Write a program to store image file from ‘http://data.pr4e.org/cover.jpg'
                    to your disk.</p>
                    <program xml:id="writingcode_network_5_sol" language="python3" interactive="activecode">
        <code>
import urllib.request, urllib.parse, urllib.error

img = urllib.request.urlopen('http://data.pr4e.org/cover.jpg').read()
fhand = open('cover.jpg', 'wb')
fhand.write(img)
fhand.close()
        </code>
    </program></solution></activity>

