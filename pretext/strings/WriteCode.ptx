    <activity xml:id="str-ex-nameInputq"  label="str-ex-nameInputq">
    <statement>
      <p>Write a program that asks a user for their name and from the input prints the first letter of their name in lowercase.</p>
    </statement>
    <program  interactive="activecode" language="python">
      <code>

      </code>
    </program>
    <solution>
      <p>Write a program that asks a user for their name and from the input prints the first letter of their name in lowercase.</p>
      <program xml:id="str-ex-nameacq-sol" interactive="activecode" language="python">
      <code>
prompt = "What is your name?"
name = input(prompt)
first = name[0]
lowerFirst = first.lower()
print(lowerFirst)    
      </code>
    </program>
    </solution>
  </activity>

