  <activity xml:id="str-ex-lower" label="str-ex-lower">
    <statement>
      <p>Write a program that asks for user input (store it in a variable named <c>user_input</c>) and prints their input in all lowercase, as well as the length of their string.</p>
    </statement>
    <program interactive="activecode" language="python" codetailor="incorrect" codetailor-fallback="str-ex-loweransw">
      <code>

====
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):
    def testOne(self):
        expected = user_input.lower() + " " + str(len(user_input))
        self.assertIn(expected, self.getOutput())
myTests().main()
      </code>
    </program>
  </activity>


