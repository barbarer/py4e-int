  <activity label="str-ex-meowacq" xml:id="str-ex-meowacq">
    <statement>
      <p>Fix the code so that only <q>meow</q> is printed.</p>
    </statement>
    <program interactive="activecode" language="python">
      <code>
sentence = "The cat goes meow."
s2 = sentence[0:17]
print(s2)
      </code>
    </program>
