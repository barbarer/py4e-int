  <activity xml:id="str-ex-floatq-pp" label="str-ex-floatq-pp" adaptive="yes" indentation="hide" language="python">
    <statement>
      <p>Arrange the blocks to use <c>find</c> and string slicing to extract the portion of <c>string</c> after the colon character and convert it into a floating point number called <c>num</c>.</p>
    </statement>
    <blocks numbered="left">
      <block order="1">
        <cline>string = "X-DSPAM-Confidence: 0.8475"</cline>
      </block>
      <block order="2">
        <choice correct="yes">
          <cline>colonpos = string.find(':')</cline>
        </choice>
        <choice>
          <cline>colonpos = string.find(".")</cline>
        </choice>
      </block>
      <block order="3">
        <choice correct="yes">
          <cline>num = float(string[colonpos+1:])</cline>
        </choice>
        <choice>
          <cline>num = float(string[colonpos:])</cline>
        </choice>
      </block>
      <block order="4">
        <cline>print(num)</cline>
      </block>
    </blocks>
  </activity>

